{
  "name": "uvapress",
  "private": true,
  "description": "University of Virginia Press website, built with Astro and Decap CMS",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/fix-link-case.mjs && node scripts/prune-unused-assets.mjs && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/antonio": "^5.2.8",
    "@fontsource/assistant": "^5.2.9",
    "@fontsource/crimson-text": "^5.2.7",
    "@fontsource/playfair-display-sc": "^5.2.8",
    "@fontsource/quicksand": "^5.2.10",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.8",
    "lodash-es": "^4.18.1",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/sanitize-html": "^2.16.1",
    "sanitize-html": "^2.17.6"
