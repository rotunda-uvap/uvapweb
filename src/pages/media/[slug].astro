---
// Media post page, design ported from the Gatsby media-page.js template.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostBody from '../../components/posts/PostBody.astro';
import RelatedBook from '../../components/posts/RelatedBook.astro';
import ShareButtons from '../../components/posts/ShareButtons.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news', (p) => p.data.type === 'media');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;

const title = post.data.title;
const url = new URL(`/media/${post.id}/`, Astro.site).href;

// Header image: the Gatsby query pulled the image file colocated in the
// post's content folder; frontmatter `image` names that same file.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/content/news/**/*.{jpg,jpeg,png,gif}',
  { eager: true }
);
const pic = post.data.image
  ? images[`/content/news/${post.id}/${post.data.image}`]?.default
  : undefined;

// related_book frontmatter holds BookID strings; titles come from the catalog
const books = await getCollection('books');
const titleById = new Map(books.map((b) => [b.data.BookID, b.data.Title]));
const relatedBooks = post.data.related_book?.map((id) => ({
  id,
  title: titleById.get(id) ?? '',
}));

const description = (post.rendered?.html ?? '').replace(/<[^>]*>/g, '').substring(0, 150);
---

<Base title={title} description={description}>
  <section class="text-gray-600 body-font">
    <div class="container px-5 py-12 mx-auto">
      <div class="flex flex-col  w-full mb-10">
        <PageHeader text={title} />
        <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-1">
          <div class="float-left px-5 pb-5">
            {pic && <Image src={pic} width={Math.min(300, pic.width)} alt="related image" />}
          </div>
          {/* the Gatsby original wrapped this in a <p>; browsers auto-close a
              <p> before block children, so a div with the same classes matches
              the hydrated rendering without the invalid nesting */}
          <div class="lg:w-3/3  leading-relaxed text-base">
            {relatedBooks && (
              <div class="float-right px-5 pb-5">
                <h6 class="uppercase px-7 py-2">Related</h6>
                {relatedBooks.map((book) => <RelatedBook id={book.id} title={book.title} />)}
              </div>
            )}
            <PostBody post={post} class="cms" />
          </div>
          <div class="px-10">
            <ShareButtons title={title} url={url} />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
