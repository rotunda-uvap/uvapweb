---
// Publicity landing, ported from the Gatsby publicity.js. The site nav links
// to the #review anchor — keep that id exactly.
import { getCollection } from 'astro:content';
import { faCircleArrowRight } from '@fortawesome/free-solid-svg-icons';
import Base from '../layouts/Base.astro';
import { excerptHtml } from '../lib/excerpt';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';

const posts = (await getCollection('news', (n) => n.data.type === 'news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const excerpt = (html: string) => excerptHtml(html, 30, true);
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title="Publicity Information: News and Events">
  <div class="container md:p-5 px-5 mx-auto">
    <div class="flex flex-col text-center w-full">
      <PageHeader text={'Media, News and Events'} />
    </div>
  </div>

  <section>
    <div class="flex flex-col text-center items-center border-b-2 pb-4">
      <a href="/staff/MK-Maco/"><h5 class="title-font font-medium text-base py-1 text-ceci-gray-mid">Sarah Borgatti</h5></a>
      <span class="font-serif text-ceci-gray-mid">(434) 924-6951</span>
      <a class="text-ceci-gray-mid text-base font-serif inline-flex items-center" href="mailto:sborgatti@virginia.edu">Email Sarah
        <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="w-4 h-4 ml-2" viewBox="0 0 24 24">
          <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
      </a>
    </div>
  </section>

  <section id="review">
    <SectionHeader text="Review Copy Requests" />
    <p class="cms leading-relaxed text-base text-left">
      If you are a journalist or journal interested in a copy of a book for review, we can supply gratis copies of titles published within the past two years.  </p>
    <p class="cms text-base">Please include the following in your email:</p>
    <ul class="pl-8 list-disc">
      <li class="font-serif text-base">Name of book and author</li>
      <li class="font-serif text-base">Your media outlet</li>
      <li class="font-serif text-base">Full contact information (name, mailing address), along with any deadlines</li>
      <li class="font-serif text-base">Links to your outlet's website</li>
    </ul>
    <p class="pt-2 text-base">Review copy requests can take up to four weeks to process. Due to the volume of requests, we are unable to provide status updates. Upon publication, please send PDFs and/or links to coverage to <a href="mailto:sborgatti@virginia.edu">sborgatti@virginia.edu.</a></p>
  </section>

  <div class="mx-auto px-4">
    <section class="flex flex-col">
      <SectionHeader text="All News Posts" />
      {posts.map((post) => {
        const html = post.rendered?.html ?? '';
        return (
          <a href={`/${post.data.type}/${post.id}/`} class="news-row group flex flex-row items-start gap-4 border-b border-gray-200 last:border-b-0 py-4 hover:bg-gray-50 transition-colors">
            <div class="shrink-0 w-16 md:w-20 h-24 md:h-28 overflow-hidden rounded-sm">
              {post.data.related_book?.length ? (
                <img
                  src={`https://upress-covers.s3.us-east-1.amazonaws.com/${post.data.related_book[0]}_M.jpg`}
                  alt="cover"
                  class="w-full h-full object-cover object-top shadow-sm"
                />
              ) : (
                <img
                  src="https://upress-covers.s3.us-east-1.amazonaws.com/noimg_lg.png"
                  alt="No cover available"
                  class="w-full h-full object-contain bg-white"
                />
              )}
            </div>

            <div class="flex-1 min-w-0">
              <div class="text-xs font-serif text-ceci-gray-mid">{fmtDate(post.data.date)}</div>
              <div class="font-display uppercase tracking-wide text-sm md:text-base leading-snug mt-0.5">{post.data.title}</div>
              {html && (
                <div class="news-excerpt text-ceci-gray-dark text-sm font-light leading-relaxed mt-1 line-clamp-2" set:html={excerpt(html)} />
              )}
              <div class="font-display uppercase text-xs tracking-widest mt-2 text-ceci-gray-mid group-hover:text-black transition-colors">
                <Icon icon={faCircleArrowRight} class="inline mr-1" /> Read More
              </div>
            </div>
          </a>
        );
      })}
    </section>
  </div>

  <style>
    .news-excerpt :global(p),
    .news-excerpt :global(h1),
    .news-excerpt :global(h2),
    .news-excerpt :global(h3),
    .news-excerpt :global(ul),
    .news-excerpt :global(ol),
    .news-excerpt :global(blockquote) {
      margin: 0;
      padding: 0;
      display: inline;
    }
  </style>
</Base>
