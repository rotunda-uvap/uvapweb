---
// "For Current Authors" page, ported from the Gatsby authors.js: CMS intro
// text plus the download-form sections and the acquisitions-staff grid
// (the old AcqStaff component).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import IndexFileDownloadButton from '../components/lists/IndexFileDownloadButton.astro';
import IndexMiniBio from '../components/lists/IndexMiniBio.astro';

const pageEntries = await getCollection('pages', (p) => p.data.title === 'Current Authors');
const pageHtml = pageEntries[0]?.rendered?.html ?? '';

// AcqStaff: allMarkdownRemark(department in "ACQ", sort title ASC)
const acqs = (await getCollection('bios', (b) => b.data.department.includes('ACQ'))).sort(
  (a, b) => a.data.title.localeCompare(b.data.title, 'en')
);
---

<Base title="Information for Current Authors">
  <section class="text-gray-600 body-font border-b-2 border-gray-100">
    <div class=" mx-auto">
      <div class="flex flex-col  w-full">
        <PageHeader text={'For Current Authors'} />
        <span class="text-sm md:text-sm text-right uppercase font-thin pb-4 text-gray-500"><a href="/prospective/">
          Prospective Authors <span class="inline-flex py-2">
          <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="w-3 h-3 md:w-4 md:h-4 ml-1 md:ml-2" viewBox="0 0 24 24">
            <path d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
          </svg></span>
        </a></span>
        {/* the old JSX wrapped this div in a <p>, which browsers hoisted out;
            rendering the div directly matches the DOM the old site produced */}
        <div class="dropCap cms" set:html={pageHtml} />
      </div>
    </div>
  </section>

  <section class="text-gray-600 body-font  border-b-2 border-gray-100">
    <div class="container p-5 mx-auto">
      <div class="text-center mb-10">
        <SectionHeader text={'Illustrations Guidelines'} />
      </div>
      <div class="flex flex-wrap lg:w-4/5 sm:mx-auto sm:mb-2 -mx-2">
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Art Guidelines" file="UVAP_Art_Guidelines.pdf" />
        </div>
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Art Log" file="UVAP_Art_Log.docx" />
        </div>
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Cover Design Questionnaire" file="UVAP_Author-Cover-Q_0.docx" />
        </div>
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Alt Text Guidelines" file="UVAP_Alt_Text_Guidelines.docx" />
        </div>
      </div>
    </div>
  </section>

  <section class="text-gray-600 body-font  border-b-2 border-gray-100">
    <div class="container p-5 mx-auto">
      <div class="text-center mb-10">
        <SectionHeader text={'Manuscript Guidelines'} />
      </div>
      <div class="flex flex-wrap lg:w-4/5 sm:mx-auto sm:mb-2 -mx-2">
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Guide to Manuscript Preparation" file="UVaP_MS_Prep_Guide.docx" />
        </div>
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Final Manuscript Basics" file="UVaP_Final_MS_Basics.docx" />
        </div>
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Order of MS Elements" file="UVaP_Order_MS_Elements.doc" />
        </div>
      </div>
    </div>
  </section>

  <section class="text-gray-600 body-font  border-b-2 border-gray-100">
    <div class="container p-5 mx-auto">
      <div class="text-center mb-10">
        <SectionHeader text={'Permissions'} />
      </div>
      <div class="flex flex-wrap lg:w-4/5 sm:mx-auto sm:mb-2 -mx-2">
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Sample Request and Release Letters" file="UVaP_Sample_Perm_Let.doc" />
        </div>
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Permissions Log" file="UVAP_Text_Permissions_Log.docx" />
        </div>
      </div>
    </div>
  </section>

  <section class="text-gray-600 body-font  border-b-2 border-gray-100">
    <div class="container p-5 mx-auto">
      <div class="text-center mb-10">
        <SectionHeader text={'Proofs'} />
      </div>
      <div class="flex flex-wrap lg:w-4/5 sm:mx-auto sm:mb-2 -mx-2">
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Reviewing the Proof and Creating the Index" file="UVaP_Proof_Index_Gdlns.pdf" />
        </div>
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Proofer's Marks" file="proofers1.gif" />
        </div>
      </div>
    </div>
  </section>

  <section class="text-gray-600 body-font  border-b-2 border-gray-100">
    <div class="container p-5 mx-auto">
      <div class="text-center mb-10">
        <SectionHeader text={'Marketing and Promoting Your Book'} />
      </div>
      <div class="flex flex-wrap lg:w-4/5 sm:mx-auto sm:mb-2 -mx-2">
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Guidelines on Keywords" file="UVAP_Guidelines_on_Keywords.docx" />
        </div>
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Marketing Questionnaire" file="UVA-Press-Marketing-Questionnaire.docx" />
        </div>
      </div>
    </div>
  </section>

  <section class="text-gray-600 body-font  border-b-2 border-gray-100">
    <div class="container p-5 mx-auto">
      <div class="text-center mb-10">
        <SectionHeader text={'Multi-Author Volumes'} />
      </div>
      <div class="flex flex-wrap lg:w-4/5 sm:mx-auto sm:mb-2 -mx-2">
        <div class="p-2 sm:w-1/2 w-full">
          <IndexFileDownloadButton name="Editor's Guidelines" file="UVaP_Vol_Ed_Gd.doc" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-2 greige">
    <div class="flex flex-col text-center w-full">
      <SectionHeader text="UVaP Editors" />
    </div>
    {/* the old AcqStaff component */}
    <div class="container px-5 py-12 mx-auto">
      <div class="flex flex-wrap -m-4 text-center">
        {acqs.map((bio) => <IndexMiniBio bio={bio} />)}
      </div>
    </div>
  </section>
</Base>
