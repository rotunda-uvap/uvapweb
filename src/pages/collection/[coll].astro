---
// /collection/{MainCollection}/ — rotunda collection pages, URL segment is
// the raw MainCollection value (spaces included), as gatsby-node created it.
// Design ported from the Gatsby rotunda-coll-page.js template.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import RotCard from '../../components/lists/RotCard.astro';

export async function getStaticPaths() {
  const rotunda = await getCollection('rotundaData');
  const mains = [...new Set(rotunda.map((r) => r.data.MainCollection).filter(Boolean))];
  return mains.map((main) => ({ params: { coll: main! }, props: { main: main! } }));
}
const { main } = Astro.props;
const rotunda = await getCollection('rotundaData', (r) => r.data.MainCollection === main);
---

<Base title={main}>
  <PageHeader text={main} />

  <section>
    <div class="container px-5 py-5 grid md:grid-cols-3 md:gap-4">
      {rotunda.map((r) => <RotCard rot={r} />)}
    </div>
  </section>

  <section class="py-5 pl-5 inline-flex items-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
      <path
        fill-rule="evenodd"
        d="M7.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l2.293 2.293a1 1 0 010 1.414z"
        clip-rule="evenodd"></path>
    </svg>
    <a href="/rotunda/"><h6 class="pl-5 font-thin">Back to all Rotunda</h6></a>
  </section>
</Base>
