---
// /staff/{name_slug}/ — design ported from the Gatsby staff-page.js template.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';

export async function getStaticPaths() {
  const bios = await getCollection('bios');
  // lowercase: Netlify force-lowercases URLs; build there directly
  return bios.map((bio) => ({ params: { name_slug: bio.data.name_slug.toLowerCase() }, props: { bio } }));
}
const { bio } = Astro.props;
const { Content } = await render(bio);
const hasBody = Boolean(bio.body?.trim());

// The Gatsby page pulled the photo with file(relativeDirectory: {eq: $relDir})
// — i.e. whatever image sits next to the bio's index.md, regardless of the
// profile_photo filename (which is stale for one bio). Mirror that: glob the
// bios content folders and match on this entry's folder id. The glob is lazy
// so only the matched photo is imported (an eager glob would ship every
// full-resolution upload in content/bios/ with the build).
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../../../content/bios/*/*.{jpg,jpeg,png,gif}'
);
const photoLoader = Object.entries(photos).find(([path]) =>
  path.includes(`/bios/${bio.id}/`)
)?.[1];
const photo = photoLoader ? (await photoLoader()).default : undefined;
---

<Base title={bio.data.title}>
  <div class="mx-auto">
    <PageHeader text={bio.data.title} />
    {
      bio.data.profile_photo && photo && (
        <div class="text-center py-2">
          {/* Image resizes at build time — photo.src would serve the raw
              upload (some are 15MB+ camera originals). inline-block matches
              the Gatsby image wrapper so text-center centers the photo. */}
          <Image src={photo} width={Math.min(300, photo.width)} alt={bio.data.title} loading="lazy" class="inline-block" />
        </div>
      )
    }
    {
      bio.data.job_title && (
        <h5 class="pt-4 pb-2 text-ceci-gray-mid font-thin tracking-wide text-center italic">
          {bio.data.job_title}
        </h5>
      )
    }
    {
      bio.data.email && (
        <h6 class="text-center tracking-wide font-thin">
          <a href={`mailto:${bio.data.email}`}>{bio.data.email}</a>
        </h6>
      )
    }
    {
      hasBody && (
        <article class="md:w-1/2 md:mx-auto py-7 cms dropCap text-lg">
          <Content />
        </article>
      )
    }
  </div>
</Base>
