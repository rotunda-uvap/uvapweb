---
// /about/ — ported from about.js: intro (About entry), anniversary note,
// quick-link cards, contact/map section, Mission / Code of Conduct / Land-use
// entries, and the two hardcoded board lists.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BoardMember from '../components/staticpages/BoardMember.astro';

const pages = await getCollection('pages');
const byTitle = (t: string) => pages.find((p) => p.data.title === t);
const about = byTitle('About');
const code = byTitle('Code of Conduct');
const mission = byTitle('Mission');
const landuse = byTitle('Land-use acknowledgment');
---

<Base title="About The University of Virginia Press">
  <section class="text-gray-600 body-font">
    <div class=" px-2 py-6 mx-auto">
      <div class="flex flex-col  w-full mb-5">
        <PageHeader text="About UVa Press" />
        <div
          class="lg:w-3/3 mx-auto leading-relaxed text-base dropCap cms"
          set:html={about?.rendered?.html ?? ''}
        />
      </div>
      <div class="mb-8 w-full leading-relaxed flex justify-center">
        <div>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.871c1.355 0 2.697.056 4.024.166C17.155 8.51 18 9.473 18 10.608v2.513M15 8.25v-1.5m-6 1.5v-1.5m12 9.75-1.5.75a3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0 3.354 3.354 0 0 1-3 0 3.354 3.354 0 0 0-3 0 3.354 3.354 0 0 1-3 0L3 16.5m15-3.379a48.474 48.474 0 0 0-6-.371c-2.032 0-4.034.126-6 .371m12 0c.39.049.777.102 1.163.16 1.07.16 1.837 1.094 1.837 2.175v5.169c0 .621-.504 1.125-1.125 1.125H4.125A1.125 1.125 0 0 1 3 20.625v-5.17c0-1.08.768-2.014 1.837-2.174A47.78 47.78 0 0 1 6 13.12M12.265 3.11a.375.375 0 1 1-.53 0L12 2.845l.265.265Zm-3 0a.375.375 0 1 1-.53 0L9 2.845l.265.265Zm6 0a.375.375 0 1 1-.53 0L15 2.845l.265.265Z"
            ></path>
          </svg>
        </div>
        <p class="text-lg">
          UVA Press celebrated its 60th anniversary in 2023! <a
            href="/downloads/UVAPress-AnnualReport-022824.pdf">View our 2023 Annual Report</a
          >
        </p>
      </div>
      <div class="flex flex-col lg:flex-row  -m-4">
        <div class="p-4 lg:w-1/4">
          <div class="flex  h-full greige p-8 flex-col">
            <div class="flex items-center mb-3">
              <div
                class="w-8 h-8 mr-3 inline-flex items-center justify-center rounded-full bg-ceci-gray-mid text-white flex-shrink-0"
              >
                <svg
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                  ></path>
                </svg>
              </div>
              <a href="/staff-list/"
                ><h2 class="text-ceci-gray-dark text-lg title-font font-medium">Staff Directory</h2
                ></a
              >
            </div>
            <div class="flex-grow">
              <p class="leading-relaxed text-base">
                Find the right person to answer your question.
              </p>
            </div>
          </div>
        </div>
        <div class="p-4 lg:w-1/4">
          <div class="flex h-full greige p-8 flex-col">
            <div class="flex items-center mb-3">
              <div
                class="w-8 h-8 mr-3 inline-flex items-center justify-center rounded-full bg-ceci-gray-mid text-white flex-shrink-0"
              >
                <svg
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <a href="/career/"
                ><h2 class="text-ceci-gray-dark text-lg title-font font-medium">Career</h2></a
              >
            </div>
            <div class="flex-grow">
              <p class="leading-relaxed text-base">
                Internships and full-time opportunities at the press.
              </p>
            </div>
          </div>
        </div>
        <div class="p-4 lg:w-1/4">
          <div class="flex  h-full greige p-8 flex-col">
            <div class="flex items-center mb-3">
              <div
                class="w-8 h-8 mr-3 inline-flex items-center justify-center rounded-full bg-ceci-gray-mid text-white flex-shrink-0"
              >
                <svg
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"
                  ></path>
                </svg>
              </div>
              <a href="/support/"
                ><h2 class="text-ceci-gray-dark text-lg title-font font-medium">Support</h2></a
              >
            </div>
            <div class="flex-grow">
              <p class="leading-relaxed text-base">
                Gifts of any amount support access to scholarship for students, faculty and
                scholars.
              </p>
            </div>
          </div>
        </div>
        <div class="p-4 lg:w-1/4">
          <div class="flex h-full greige p-8 flex-col">
            <div class="flex items-center mb-3">
              <div
                class="w-8 h-8 mr-3 inline-flex items-center justify-center rounded-full bg-ceci-gray-mid text-white flex-shrink-0"
              >
                <svg
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"
                  ></path>
                </svg>
              </div>
              <a href="/permissions/"
                ><h2 class="text-ceci-gray-dark text-lg title-font font-medium">
                  Rights and Permissions
                </h2></a
              >
            </div>
            <div class="flex-grow">
              <p class="leading-relaxed text-base">
                Reprints, as well as classroom and academic permissions requests.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="flex mt-6 justify-center">
      <div class="w-16 h-1 rounded-full bg-gray-800 inline-flex"></div>
    </div>
  </section>

  <section class="text-gray-600 body-font relative" id="Contact">
    <div class="container px-5 py-24 mx-auto flex sm:flex-nowrap flex-wrap">
      <div
        class="lg:w-2/3 md:w-1/2 bg-gray-300 rounded-lg overflow-hidden sm:mr-10 p-10 flex items-end justify-start relative"
      >
        <iframe
          width="100%"
          height="100%"
          class="absolute inset-0"
          frameborder="0"
          title="map"
          marginheight="0"
          marginwidth="0"
          scrolling="no"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d25142.53534541059!2d-78.51017630392049!3d38.02804744531566!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89b3864fd48486e7%3A0x8fa6c3eae630f15!2sBemiss%20House%20(University%20Press)%2C%20210%20Sprigg%20Ln%2C%20Charlottesville%2C%20VA%2022903!5e0!3m2!1sen!2sus!4v1619475440081!5m2!1sen!2sus;output=embed"
        ></iframe>
        <div class="bg-white relative flex flex-wrap py-6 rounded shadow-md">
          <div class="lg:w-1/2 px-6">
            <h2 class="title-font font-semibold text-ceci-gray-dark tracking-widest text-sm">
              ADDRESS
            </h2>
            <p class="mt-1">210 Sprigg Lane, Charlottesville, VA 22903-2417</p>
          </div>
          <div class="lg:w-1/2 px-6 mt-4 lg:mt-0">
            <h2 class="title-font font-semibold text-ceci-gray-dark tracking-widest text-sm">
              EMAIL
            </h2>
            {/* the original JSX had a malformed class attribute here; intent preserved */}
            <a href="mailto:vapress@virginia.edu" class="text-gray-500 leading-relaxed"
              >vapress@virginia.edu</a
            >
            <h2 class="title-font font-semibold text-ceci-gray-dark tracking-widest text-sm mt-4">
              PHONE
            </h2>
            <p class="leading-relaxed">434 924-3468</p>
          </div>
        </div>
      </div>
      <div
        class="lg:w-1/3 md:w-1/2 bg-white flex flex-col md:ml-auto w-full md:py-8 mt-8 md:mt-0 font-display"
      >
        <h2 class="text-ceci-gray-dark text-lg mb-1 font-medium title-font">
          Postal and Shipping Address
        </h2>
        <div class="leading-relaxed mb-5 text-gray-600 flex flex-col">
          <div>University of Virginia Press</div>
          <div>P.O. Box 400318</div>
          <div>Charlottesville, VA 22904-4318</div>
        </div>
        <h2 class="text-ceci-gray-dark text-lg mb-1 font-medium title-font">
          Courier Delivery (FedEx, UPS, etc.)
        </h2>

        <div class="leading-relaxed mb-5 text-gray-600 flex flex-col98">
          <div>University of Virginia Press</div>
          <div>210 Sprigg Lane</div>
          <div>Charlottesville, VA 22903-2417</div>
        </div>
        <p class="text-sm text-gray-500 mt-3">
          If you are driving, we usually have parking space available in the driveway just past
          Bemiss House on the left; we do not have visitor permits for the Alumni Hall parking lot.
        </p>
      </div>
    </div>
  </section>

  <section>
    <SectionHeader text="Press Mission" />
    <div
      class="lg:w-3/3 mx-auto leading-relaxed text-base dropCap cms"
      set:html={mission?.rendered?.html ?? ''}
    />
  </section>

  <section>
    <SectionHeader text="Code of Conduct" />
    <div
      class="lg:w-3/3 mx-auto leading-relaxed text-base dropCap cms"
      set:html={code?.rendered?.html ?? ''}
    />
  </section>
  <section>
    <SectionHeader text="Land-use Acknowledgment" />
    <div
      class="lg:w-3/3 mx-auto leading-relaxed text-base dropCap cms"
      set:html={landuse?.rendered?.html ?? ''}
    />
  </section>

  <section class="py-5 text-gray-700 border-b-2 border-gray-100" id="board">
    <SectionHeader text="Current Editorial Board Members" />
    <div>
      <BoardMember
        name="Gustavo Pellón, chair"
        title="Professor Emeritus of Spanish, University of Virginia"
      />
      <BoardMember
        name="Jessica Andruss"
        title="Assistant Professor of Religious Studies, University of Virginia"
      />

      <BoardMember
        name="Kirt Von Daacke"
        title="Associate Professor of History, University of Virginia"
      />

      <BoardMember
      name="Christa Dierksheide"
      title="Brockman Foundation Jefferson Scholars Foundation Professor of History, University of Virginia"
    />

      <BoardMember
        name="Laurent Dubois"
        title="John L. Nau III Professor of the History & Principles of Democracy, University of Virginia"
      />

      <BoardMember
        name="Njelle Hamilton"
        title="Associate Professor of English & Africana Studies, University of Virginia"
      />
    
      <BoardMember
        name="Julian Maxwell Hayter"
        title="Associate Professor of Leadership Studies, University of Richmond"
      />
      <BoardMember
        name="Angel Adams Parham"
        title="Associate Professor of Sociology, University of Virginia"
      />
      <BoardMember
        name="Katrina Powell"
        title="Director of the Center for Refugee, Migrant, and Displacement Studies, Virginia Tech "
      />
      <BoardMember
        name="Charlotte Rogers"
        title="Associate Professor of Spanish, University of Virginia"
      />

      <p class="py-4 px-5 italic">Ex Officio</p>
      <BoardMember name="Brie Gertler" title="Interim Provost for Academic Affairs" />
      <BoardMember
        name="Jonathan D. Bowen"
        title="Assistant to the President and Writer, University of Virginia"
      />
      <BoardMember name="Eric Brandt" title="Director, University of Virginia Press" />
    </div>
  </section>

  <section class="py-5 text-gray-700 border-b-2 border-gray-100" id="board">
    <SectionHeader text="Current Advancement Council Members" />
    <div>
      <BoardMember name="Edward L. Ayers," title="President Emeritus of the University of Richmond" />
      <BoardMember
        name="L. J. Bourgeois III"
        title="Emeritus Professor of Business Administration, University of Virginia Darden School of Business"
      />
      <BoardMember
        name="Samuel M. Bemiss III"
        title="Executive Vice President at Rampart Communications, Inc."
      />
      <BoardMember
        name="Johnnetta Betsch Cole"
        title="President Emerita of Spelman College & Bennett College for Women,  Director Emerita of the Smithsonian National Museum of African Art"
      />
      <BoardMember name="Charles Cowen" title="Owner at Le Forge de Montolieu" />
 
      <BoardMember
        name="Lynn Pasquerella"
        title="President of the American Association of Colleges and Universities"
      />

      <BoardMember
        name="Gustavo Pellón"
        title="Professor Emeritus of Spanish, University of Virginia"
      />
      <BoardMember
      name="Jeff E. Shapiro"
      title="Scholar, University of Virginia Center for Politics"
    />
      <BoardMember
        name="Matthew Tennant"
        title="Senior Minister of the University Baptist Church, Charlottesville"
      />

      <BoardMember
      name="W. McIlwaine Thompson, Jr."
      title="Board member, Curry School of Education Foundation, Heart Center at UVA School of Medicine, Charlottesville Tomorrow Board of Directors"
    />
      <BoardMember
      name="Elsie Wilson Thompson"
      title="Director, Foundation of the Virginia State Arboretum, Co-Vice Chair of the Advisory Board, Fralin Museum"
    />
   
      <BoardMember
      name="John M. Unsworth"
      title="Former Dean of Libraries and Professor Emeritus of English, University of Virginia"
    />

      <p class="py-4 px-5 italic">Ex Officio</p>
      <BoardMember name="Brie Gertler" title="Interim Provost for Academic Affairs" />
      <BoardMember
        name="Kathryn Jarvis"
        title="Associate Vice President, Principal Gifts, University of Virginia"
      />
      <BoardMember name="Eric Brandt" title="Director, University of Virginia Press" />
      <BoardMember name="Jeff Shifflett" title="Director of Finance, University of Virginia Press" />
    </div>
  </section>
</Base>
