---
// /title/{BookID}/ (press books) and /title/{RotID}/ (rotunda titles) —
// one URL namespace, two shapes, exactly as gatsby-node created them.
import { getCollection, render } from 'astro:content';
import Interim from '../../components/Interim.astro';

export async function getStaticPaths() {
  const [books, rotundaData, rotundaInfo] = await Promise.all([
    getCollection('books', (b) => !b.data.Rotunda),
    getCollection('rotundaData'),
    getCollection('rotundaInfo'),
  ]);
  const infoByRid = new Map(rotundaInfo.map((e) => [e.data.rid, e]));
  return [
    ...books.map((book) => ({
      params: { bid: book.data.BookID },
      props: { kind: 'book' as const, book, rot: undefined, info: undefined },
    })),
    ...rotundaData.map((rot) => ({
      params: { bid: rot.data.RotID },
      props: { kind: 'rotunda' as const, book: undefined, rot, info: infoByRid.get(rot.data.RotID) },
    })),
  ];
}

const { kind, book, rot, info } = Astro.props;
const title = kind === 'book' ? book!.data.Title : (info?.data.title ?? rot!.data.RotID);
const Content = info ? (await render(info)).Content : null;
const description = (book?.data as any)?.MainDescription?.html as string | undefined;
---

{kind === 'book' ? (
  <Interim title={title} kicker="Book">
    {book!.data.Subtitle && <h2 class="italic text-ceci-gray-mid">{book!.data.Subtitle}</h2>}
    {book!.data.AuthorCredit && (
      <p class="font-display uppercase tracking-wider py-2">{book!.data.AuthorCredit}</p>
    )}
    {description && <div class="py-4" set:html={description} />}
    {book!.data.Series?.length ? (
      <p class="text-sm text-ceci-gray-mid">Series: {book!.data.Series.map((s) => s.name).join(', ')}</p>
    ) : null}
    {book!.data.Subjects?.length ? (
      <p class="text-sm text-ceci-gray-mid">Subjects: {book!.data.Subjects.map((s) => s.name).join(', ')}</p>
    ) : null}
  </Interim>
) : (
  <Interim title={title} kicker="Rotunda">
    {Content && <div class="py-4"><Content /></div>}
    {rot!.data.MainCollection && (
      <p class="text-sm text-ceci-gray-mid">Collection: {rot!.data.MainCollection}</p>
    )}
  </Interim>
)}
