---
// Media-posts index, ported from the Gatsby media-posts.js. The old query had
// no explicit sort (Gatsby default order); we sort newest-first so the order
// is deterministic and matches the other news indexes.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('news', (n) => n.data.type === 'media')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const excerpt = (text: string) => text.split(' ').splice(0, 50).join(' ') + '...';
const fmtDate = (d: Date) => d.toISOString().slice(0, 10);
---

<Base>
  <div class="container px-5 py-12 mx-auto">
    <h1 class="sm:text-3xl text-2xl p-4 font-sans uppercase text-gray-900 text-center">All Media Posts</h1>
    {posts.map((post) => (
      <div class="mt-6">
        <div class="max-w-4xl px-10 py-6 bg-white rounded-lg shadow-md">
          <div class="flex justify-between items-center"><span class="font-light text-gray-800">{fmtDate(post.data.date)}</span><span
            class="px-2 py-1 bg-gray-600 text-gray-100 font-bold rounded hover:bg-gray-500">{post.data.type}</span>
          </div>
          <div class="mt-2"><a class="text-2xl text-gray-700 font-bold hover:underline" href={`/${post.data.type}/${post.id}/`}>{post.data.title}</a>
            <div class="mt-2 text-gray-600" set:html={excerpt(post.data.description ?? '')} />
          </div>
          <div class="flex justify-between items-center mt-4"><a href={`/${post.data.type}/${post.id}/`}>Read more</a>
          </div>
        </div>
      </div>
    ))}
  </div>
</Base>
