---
// /prospective/ — ported from prospective.js: intro (Prospective Authors
// entry), proposal/questionnaire download sections, acquisitions team, and
// the active/completed series lists.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AcqStaff from '../components/staticpages/AcqStaff.astro';
import ActiveSeries from '../components/staticpages/ActiveSeries.astro';
import CompletedSeries from '../components/staticpages/CompletedSeries.astro';
import FileDownloadButton from '../components/staticpages/FileDownloadButton.astro';

const [page] = await getCollection('pages', (p) => p.data.title === 'Prospective Authors');
---

<Base title="Prospective Authors">
  <section class="border-b-2 border-gray-100 text-gray-600 body-font">
    <div class=" mx-auto">
      <div class="flex flex-col text-center w-full">
        <PageHeader text="For Prospective Authors" />
        <span class="text-sm md:text-sm font-thin uppercase text-right text-gray-500 pb-4">
          <a href="/authors/">
            Current Authors <span class="inline-flex py-2">
              <svg
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                class="w-3 h-3 md:w-4 md:h-4 ml-1 md:ml-2"
                viewBox="0 0 24 24"
              >
                <path d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
              </svg>
            </span>
          </a>
        </span>
        {/* the original nested this div inside a <p> (invalid HTML the browser
            unwrapped); the p's classes move onto the wrapper */}
        <div class="lg:w-3/3 leading-relaxed text-left">
          <div class="cms dropCap" set:html={page.rendered?.html ?? ''} />
        </div>
      </div>
    </div>
  </section>

  <section class="py-4 border-b-2 border-gray-100 text-gray-600 body-font">
    <div class="container p-5 mx-auto">
      <div class="text-center mb-10">
        <SectionHeader text="Outline for a Book Proposal" />
        <p class="text-base leading-relaxed xl:w-2/4 lg:w-3/4 mx-auto">
          When preparing your book prospectus for submission, you may follow this outline or you may
          submit a differently formatted proposal. We ask that you submit a CV along with your
          overview materials. Please do not attach the full manuscript at this stage.
        </p>
      </div>
      <div class="flex flex-wrap lg:w-4/5 sm:mx-auto sm:mb-2 -mx-2">
        <div class="p-2 sm:w-1/2 w-full">
          <FileDownloadButton name="Outline" file="UVaP_Book_Proposal.doc" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-b-2 border-gray-100 text-gray-600 body-font">
    <div class="container p-5 mx-auto">
      <div class="text-center mb-10">
        <SectionHeader text="Prospective Author Questionnaire" />
        <p class="text-base leading-relaxed xl:w-2/4 lg:w-3/4 mx-auto">
          Once your proposal or manuscript has been invited for peer review, please submit this
          questionnaire to your acquisitions editor.
        </p>
      </div>
      <div class="flex flex-wrap lg:w-4/5 sm:mx-auto sm:mb-2 -mx-2">
        <div class="p-2 sm:w-1/2 w-full">
          <FileDownloadButton name="Author Questionnaire" file="UVaP_Author_Questionnaire.doc" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-b-2 border-gray-100">
    <div class="container p-5 mx-auto">
      <div class="flex flex-col text-center w-full">
        <SectionHeader text="Our Acquisitions Team" />
      </div>

      <AcqStaff />
    </div>
  </section>

  <ActiveSeries />
  <CompletedSeries />
</Base>
