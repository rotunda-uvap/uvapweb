---
// /rotunda-purchase/ — Rotunda pricing page. Port of
// src/pages/rotunda-purchase.js. This page is edited regularly by the press:
// tables, prices, text, and classes are kept verbatim from the Gatsby page
// (including its duplicate id="TIERS" and lowercase colspan attributes).
import Base from '../layouts/Base.astro';
import RotundaMain from '../components/rotunda/RotundaMain.astro';
import RotundaHeader from '../components/rotunda/RotundaHeader.astro';
