---
// Homepage, ported from the Gatsby index.js
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import HomepageBanner from '../components/HomepageBanner.astro';
import CoverCarousel from '../components/CoverCarousel.astro';
import NewsEventEx from '../components/NewsEventEx.astro';
import RotundaNews from '../components/RotundaNews.astro';
import FeaturedCollectionSection from '../components/FeaturedCollectionSection.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import voLogo from '../assets/vo.png';
// NOTE: seasonal catalog cover — swapped by hand each season, same as the
// Gatsby site. Candidate for a Decap-managed field in the Phase 3 CMS pass.
import catalogCover from '../assets/fall26.jpg';

const [homepage, books] = await Promise.all([
  getCollection('homepage', (e) => e.data.title === 'Current'),
  getCollection('books'),
]);
const home = homepage[0].data;
const top = home.top_banner[0] as Record<string, string>;
const titleById = new Map(books.map((b) => [b.data.BookID, b.data.Title]));
const featuredItems = home.featured_books.map((bid) => ({ bid, title: titleById.get(bid) }));
---

<Base>
  <HomepageBanner
    id={top.banner_id}
    book_title={top.banner_title}
    author={top.banner_author}
    quote={top.banner_quote}
    subtitle={top.banner_subtitle}
    attr={top.banner_attr}
  />

  <section class="py-4 border-b-2 border-gray-100">
    <SectionHeader text="Featured Books" />
    <div class="py-5">
      <CoverCarousel items={featuredItems} label="Featured books carousel" />
    </div>
  </section>

  <section class="py-4 border-b-2 border-gray-100">
    <NewsEventEx />
  </section>

  <section class="py-4 border-b-2 border-gray-100 greige w100">
    <SectionHeader text="ROTUNDA DIGITAL IMPRINT" />
    <RotundaNews />
  </section>

  <section class="py-4 border-b-2 border-gray-100">
    <SectionHeader text="IN THE NEWS" />
    <FeaturedCollectionSection />
  </section>

  <section class="py-4 border-b-2 border-gray-100">
    <SectionHeader text="Open Access" />
    <div class="flex flex-col items-center">
      <a href="https://open.upress.virginia.edu/">
        <Image src={voLogo} width={500} alt="virginia open logo" />
      </a>
      <p class="py-4 dropCap text-base text-gray-800">
        V/O: Virginia Open, a collection of University of Virginia Press titles made freely
        available. On this imprint, you will find both open-access monographs from The University of
        Virginia Press, readable in your browser or via download, and links to open-access websites
        published under our Rotunda imprint or in collaboration with partner institutions.
      </p>
    </div>
  </section>

  <section class="py-4 border-b-2 border-gray-100">
    <SectionHeader text="Current Catalog" />
    <div class="flex flex-col items-center">
      <div class="md:pb-0 pb-4">
        <a href="/catalog/">
          <Image src={catalogCover} width={300} alt="current catalog cover" />
        </a>
      </div>
    </div>
  </section>

  <div class="py-4 greige">
    <div class="container mx-auto px-6">
      <NewsletterForm />
    </div>
  </div>
</Base>
