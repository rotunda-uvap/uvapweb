---
// Browse-all-titles page, ported from the Gatsby books.js.
// The site nav links straight to the anchor sections — keep the ids exactly:
// #top, #imprints, #subjects, #series, #recent, #awardwinners, #AZ.
import { getCollection } from 'astro:content';
import kebabCase from 'lodash-es/kebabCase';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import GoToTop from '../components/GoToTop.astro';
import IndexBookCard from '../components/lists/IndexBookCard.astro';
import IndexAwardWinners from '../components/lists/IndexAwardWinners.astro';

// Helper function to convert text to title case (verbatim from books.js)
const toTitleCase = (str: string) =>
  str
    .split(' ')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
    .join(' ');

const [seriesEntries, books] = await Promise.all([
  getCollection('seriesData'),
  getCollection('books'),
]);

// allSeriesJson(sort: seriesName ASC)
const series = seriesEntries
  .map((s) => s.data as any)
  .sort((a, b) => a.seriesName.localeCompare(b.seriesName, 'en'));

// Gatsby group(field: Imprint.imprintName / Subjects.name) — name + count,
// groups ordered alphabetically
const imprintCounts = new Map<string, number>();
const subjectCounts = new Map<string, number>();
for (const book of books) {
  const b = book.data as any;
  for (const imp of b.Imprint ?? []) {
    imprintCounts.set(imp.imprintName, (imprintCounts.get(imp.imprintName) ?? 0) + 1);
  }
  for (const subj of b.Subjects ?? []) {
    subjectCounts.set(subj.name, (subjectCounts.get(subj.name) ?? 0) + 1);
  }
}
const imprints = [...imprintCounts.entries()].sort((a, b) => a[0].localeCompare(b[0], 'en'));
const subjects = [...subjectCounts.entries()].sort((a, b) => a[0].localeCompare(b[0], 'en'));

// published within the last year, newest first
const recent = books
  .filter((b) => b.data.DaysSincePublication > 0 && b.data.DaysSincePublication < 365)
  .sort((a, b) => a.data.DaysSincePublication - b.data.DaysSincePublication);

const allbooks = [...books].sort((a, b) => a.data.Title.localeCompare(b.data.Title, 'en'));
---

<Base title="Browse all titles">
  <PageHeader text={'Browse our Titles'} />

  <section>
    <div class="flex flex-col lg:flex-row w-10/12 mx-auto -m-4 border-b-2 border-gray-100 pb-4" id="top">
      <div class="p-4 lg:w-1/5">
        <div class="flex h-full greige p-3 flex-col place-content-center items-center">
          <a href="#AZ"><h2 class="text-ceci-gray-dark tracking-wide text-lg uppercase font-thin">A-Z</h2></a>
        </div>
      </div>
      <div class="p-4 lg:w-1/5">
        <div class="flex  h-full greige p-3 flex-col place-content-center items-center">
          <a href="#recent"><h2 class="text-ceci-gray-dark text-lg tracking-wide uppercase font-thin">Recently Published</h2></a>
        </div>
      </div>
      <div class="p-4 lg:w-1/5">
        <div class="flex  h-full greige p-3 flex-col place-content-center items-center">
          <a href="#subjects"><h2 class="text-ceci-gray-dark text-lg tracking-wide uppercase font-thin">By Subject</h2></a>
        </div>
      </div>
      <div class="p-4 lg:w-1/5">
        <div class="flex h-full greige p-3 flex-col place-content-center items-center">
          <a href="#series"><h2 class="text-ceci-gray-dark text-lg tracking-wide uppercase font-thin">By Series</h2></a>
        </div>
      </div>
      <div class="p-4 lg:w-1/5">
        <div class="flex h-full greige p-3 flex-col place-content-center items-center">
          <a href="#awardwinners"><h2 class="text-ceci-gray-dark uppercae tracking-wide text-lg uppercase font-thin">Award Winners</h2></a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 text-ceci-gray-dark border-b-2 border-gray-100" id="imprints">
    <SectionHeader text={'Our imprints'} />
    <div class="container md:flex md:flex-wrap py-10 mx-auto items-center">
      {imprints.map(([name, count]) => (
        <div class="mb-2 px-2 font-display items-center">
          <a href={`/imprints/${kebabCase(name)}/`} class="text-ceci-gray-dark hover:text-gray-800">{name} ({count})</a>
        </div>
      ))}
    </div>
  </section>

  <section class="py-5 text-ceci-gray-dark border-b-2 border-gray-100" id="subjects">
    <SectionHeader text={'Our Subjects'} />
    <div class="container md:flex md:flex-wrap py-10 mx-auto items-center">
      {subjects.map(([name, count]) => (
        <div class="mb-2 px-2 font-display items-center">
          <a href={`/subject/${kebabCase(name)}/`} class="text-ceci-gray-dark hover:text-gray-800"> {toTitleCase(name)} ({count})</a>
        </div>
      ))}
    </div>
  </section>

  <section class="text-ceci-gray-dark pb-4 py-6 border-b-2 border-gray-100" id="series">
    <SectionHeader text={'Our Series'} /><a href="/series/"><div class="text-sm text-right uppercase font-thin text-ceci-gray-mid">All Active Series <span class="inline-flex items-center mt-4">
      <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="w-4 h-4 ml-2" viewBox="0 0 24 24">
        <path d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
      </svg></span></div></a>

    <div class="container flex flex-wrap py-10 mx-auto items-center">
      {series.map((ser) => (
        <div class="md:w-1/2 mb-2 px-2 font-display">
          <a href={`/series/${ser.seriesID}/`} class="text-ceci-gray-dark hover:text-gray-800">{ser.seriesName}</a>
        </div>
      ))}
      <GoToTop />
    </div>
  </section>

  <section id="recent" class="py-5 text-gray-700 border-b-2 border-gray-100">
    <SectionHeader text={'Recent Releases'} />
    <div class="flex flex-wrap gap-2 py-5">
      {recent.map((book) => (
        <IndexBookCard fields={book.data as any} />
      ))}
      <GoToTop />
    </div>
  </section>

  <section id="awardwinners">
    <IndexAwardWinners />
    <GoToTop />
  </section>

  <section id="AZ" class="py-5 text-gray-700 border-b-2 border-gray-100">
    <SectionHeader text={'All Books A - Z '} />
    <div class="container py-5">
      {allbooks.map((book) => (
        <a href={`/title/${book.data.BookID}/`}>
          <p class="text-lg py-2 font-serif tracking-wide">{book.data.Title} - <span class="text-sm">{book.data.AuthorCredit}</span></p>
        </a>
      ))}
      <GoToTop />
    </div>
  </section>
</Base>
