---
// Flip-card book tile, ported from the Gatsby BookCard.js + BookCard.css.
// `fields` mirrors the old BookQFragment shape — pass `book.data as any`.
interface Props {
  fields: any;
}
const { fields } = Astro.props;
const { Title, Subtitle, AuthorCredit, CoverImageMain, BookID, InternalSeriesVolume } = fields;
const BASE_URL = 'https://covers.upress.virginia.edu';
const imageSrc = `${BASE_URL}/${CoverImageMain}`;
---

<a href={`/title/${BookID}/`}>
  <div class="flip-card">
    <div class="flip-card-inner">
      {CoverImageMain ? (
        <div class="flip-card-front">
          <div class="mx-auto my-auto self-center">
            <img
              src={imageSrc}
              width="150"
              height="224"
              alt={Title}
              style="object-fit: contain"
            />
          </div>
        </div>
      ) : (
        <div class="flip-card-front px-1 bg-white ">
          <p class="text-base text-ceci-gray-dark uppercase pt-3 px-1 underline font-sans">{Title}</p>
          {InternalSeriesVolume && <p class="text-sm pt-2 text-ceci-gray-mid italic font-serif ">{InternalSeriesVolume}</p>}
          <p class="text-sm pt-2 text-ceci-gray-mid italic font-serif ">{Subtitle}</p>
          <p class="text-sm font-light font-display text-gray-400  pt-2">{AuthorCredit}</p>
        </div>
      )}
      <div class="flip-card-back px-1 bg-white  ">
        <p class="text-base text-gray-700 uppercase pt-3 px-1 underline font-sans">{Title}</p>
        {InternalSeriesVolume && <p class="text-sm pt-2 text-ceci-gray-mid italic font-serif ">{InternalSeriesVolume}</p>}
        <p class="text-sm pt-2 text-gray-500 italic font-serif ">{Subtitle}</p>
        <p class="text-sm font-light font-display text-gray-400  pt-2">{AuthorCredit}</p>
      </div>
    </div>
  </div>
</a>

<style>
  /* verbatim from the Gatsby BookCard.css */
  .flip-card {
    background-color: transparent;
    width: 200px;
    height: 275px;
    perspective: 1000px;
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    text-align: center;
    transition: transform 0.6s;
    transform-style: preserve-3d;
  }

  .flip-card:hover .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-card-front,
  .flip-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .flip-card-front {
    color: black;
  }

  .flip-card-back {
    transform: rotateY(180deg);
  }
</style>
