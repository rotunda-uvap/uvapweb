---
// Staff mini-bio card, ported from the Gatsby MiniBio.js.
import type { CollectionEntry } from 'astro:content';

interface Props {
  bio: CollectionEntry<'bios'>;
}
const { bio } = Astro.props;
const { title, job_title, name_slug, email, phone } = bio.data;
// the old component stripped non-ASCII characters that crept into CMS emails
const cleanEmail = email.replace(/[^\x00-\x7F]/g, '');
---

<div class="p-4 md:w-1/3 sm:w-1/2 w-full">
  <div class="flex flex-col items-center">
    <a href={`/staff/${name_slug}/`}>
      <h5 class="text-lg font-thin tracking-wide text-ceci-gray-dark">{title}</h5>
    </a>
    <span class="text-ceci-gray-mid py-1 font-thin font-display text-lg">{job_title}</span>
    {phone && <span class="text-base text-ceci-gray-dark font-display tracking-wide">{phone}</span>}
    <a class="text-ceci-gray-mid text-base py-1 inline-flex font-display items-center " href={`mailto:${cleanEmail}`}>{cleanEmail}
      <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="w-4 h-4 ml-2" viewBox="0 0 24 24">
        <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
      </svg>
    </a>
  </div>
</div>
