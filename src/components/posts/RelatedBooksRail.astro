---
// "Related" book-cover sidebar shared verbatim by the Gatsby
// NewsPageTemplate.js and author-corner.js templates (row on mobile,
// column on md+, ordered after the body).
import RelatedBook from './RelatedBook.astro';

interface Props {
  books: { id: string; title: string }[];
}
const { books } = Astro.props;
---

<div class="order-last px-5 pb-7 flex md:flex-col flex-row items-center ">
  <h6 class="hidden md:block uppercase py-2 font-thin tracking-widest font-sans">Related</h6>
  {books.map((book) => <RelatedBook id={book.id} title={book.title} />)}
</div>
