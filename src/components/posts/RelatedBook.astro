---
// Cover-image link to a book page. Ported from the Gatsby
// src/components/RelatedBook.js (relative ../../title/{id} → absolute /title/{id}/).
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<a href={`/title/${id}/`}><img src={`https://upress-covers.s3.us-east-1.amazonaws.com/${id}_M.jpg`} alt={title} title={title} /></a>
