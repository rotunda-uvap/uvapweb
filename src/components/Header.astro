---
// Site header with mega-menu. Design ported from the Gatsby Megamenu.js;
// implementation rebuilt: menu defined once (nav-data.ts), rendered for both
// mobile and desktop, toggled with the same zero-JS checkbox mechanism.
import { Image } from 'astro:assets';
import {
  faFacebook,
  faXTwitter,
  faInstagram,
  faBluesky,
} from '@fortawesome/free-brands-svg-icons';
import { faMagnifyingGlass } from '@fortawesome/free-solid-svg-icons';
import Icon from './Icon.astro';
import { navColumns } from './nav-data';
import logo from '../assets/black.png';

const socials = [
  { icon: faFacebook, href: 'https://www.facebook.com/uvapress', label: 'Facebook' },
  { icon: faBluesky, href: 'https://bsky.app/profile/uvapress.bsky.social', label: 'Bluesky' },
  { icon: faXTwitter, href: 'https://twitter.com/uvapress', label: 'X (formerly Twitter)' },
  { icon: faInstagram, href: 'https://www.instagram.com/uvapress', label: 'Instagram' },
];
---

<h1 class="sr-only">University of Virginia Press</h1>

{/* Mobile */}
<nav
  id="mobile-menu"
  aria-label="Mobile navigation"
  class="md:hidden border-b-2 flex flex-row z-40 tracking-wide"
>
  <div class="flex flex-row w-screen">
    <div class="flex">
      <div class="block text-ceci-gray-dark w-64 py-3">
        <a href="/"><Image src={logo} alt="University of Virginia Press - Home" /></a>
      </div>
      <div class="toggleable">
        <input
          type="checkbox"
          value="selected"
          id="toggle-one"
          aria-labelledby="small-menu close-small-menu"
          class="toggle-input"
        />
        <div class="py-6 absolute right-4">
          <label id="small-menu" for="toggle-one">
            <span class="text-gray-400">
              <svg class="fill-current h-6 w-6" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <title>Menu</title>
                <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z" />
              </svg>
            </span>
          </label>
        </div>
        <div class="p-3 mega-menu mb-16 sm:mb-0 shadow-xl bg-ceci-gray-dark">
          <div class="w-full flex flex-wrap justify-between mx-2 text-gray-400 font-sans font-thin uppercase">
            {navColumns.map((col, i) => (
              <div
                class={`px-4 w-full sm:w-1/2 lg:w-1/5 border-gray-600 pb-6 pt-6 lg:pt-3 ${
                  i < navColumns.length - 1 ? 'border-b sm:border-r lg:border-b-0' : ''
                }`}
              >
                <h3 class="text-xl text-white font-sans mb-2">{col.heading}</h3>
                {col.links.map((l) => (
                  <div>
                    <a href={l.href} class="uppercase block text-lg text-gray-400 hover:text-gray-300">
                      {l.label}
                    </a>
                  </div>
                ))}
              </div>
            ))}
          </div>
          <label id="close-small-menu" for="toggle-one">
            <span class="uppercase block text-sm text-gray-300 float-right">Close X</span>
          </label>
        </div>
      </div>
    </div>
  </div>
</nav>

{/* Desktop */}
<nav
  aria-label="Main navigation"
  class="hidden md:block font-sans text-ceci-gray-mid font-thin uppercase border-b-2 z-40 tracking-wide"
>
  <div class="flex flex-row justify-center place-content-center lg:text-lg">
    <div class="flex">
      <div class="flex items-center mb-4 md:mb-0">
        <div class="block">
          <a href="/"><Image src={logo} alt="University of Virginia Press - Home" /></a>
        </div>
      </div>
      <div class="toggleable">
        <input
          type="checkbox"
          value="selected"
          id="toggle-big"
          aria-labelledby="bigmenu close-menu"
          class="toggle-input"
        />
        <div class="space-x-7 flex text-ceci-gray-mid font-thin tracking-wide items-center justify-center place-content-center py-3">
          <label id="bigmenu" for="toggle-big" class="flex flex-row gap-4">
            <span class="hover:text-ceci-gray-dark md:ml-5">About</span>
            <span class="hover:text-ceci-gray-dark">Titles</span>
            <span class="hover:text-ceci-gray-dark">For Authors</span>
            <span class="hover:text-ceci-gray-dark">For Instructors</span>
            <span class="hover:text-ceci-gray-dark">Rotunda Digital</span>
          </label>
          <a class="font-semibold text-orange-700 hover:text-orange-700 md:ml-5" href="/support/">Give</a>
          {socials.map((s) => (
            <a href={s.href} aria-label={s.label}>
              <Icon icon={s.icon} class="hover:text-ceci-gray-dark text-ceci-gray-mid" />
            </a>
          ))}
          <a href="/book-search/" aria-label="Search">
            <Icon icon={faMagnifyingGlass} class="hover:text-ceci-gray-dark text-ceci-gray-mid" />
          </a>
        </div>
        <div class="p-6 mega-menu mb-16 sm:mb-0 shadow-xl bg-ceci-gray-dark">
          <div class="container mx-auto w-full flex flex-wrap justify-between">
            {navColumns.map((col, i) => (
              <div
                class={`px-4 w-full sm:w-1/2 lg:w-1/5 border-gray-600 pb-6 pt-6 lg:pt-3 ${
                  i < navColumns.length - 1 ? 'border-b sm:border-r lg:border-b-0' : ''
                }`}
              >
                <h3 class="text-xl text-white font-sans mb-2">{col.heading}</h3>
                {col.links.map((l) => (
                  <div>
                    <a href={l.href} class="uppercase block text-lg text-gray-400 hover:text-gray-300">
                      {l.label}
                    </a>
                  </div>
                ))}
              </div>
            ))}
          </div>
          <label id="close-menu" for="toggle-big">
            <span class="uppercase block text-sm text-gray-400 hover:text-gray-300 float-right">Close X</span>
          </label>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .mega-menu {
    display: none;
    left: 0;
    position: absolute;
    text-align: left;
    width: 100%;
    z-index: 1000;
  }

  .toggleable > label:after {
    content: '\25BC';
    font-size: 10px;
    padding-left: 6px;
    position: relative;
    top: -1px;
  }

  .toggle-input {
    display: none;
  }
  .toggle-input:not(:checked) ~ .mega-menu {
    display: none;
  }
  .toggle-input:checked ~ .mega-menu {
    display: block;
  }
  .toggle-input:checked + div label {
    color: rgb(43, 42, 42);
  }
  .toggle-input:checked ~ label:after {
    content: '\25B2';
    font-size: 10px;
    padding-left: 6px;
    position: relative;
    top: -1px;
  }
</style>
