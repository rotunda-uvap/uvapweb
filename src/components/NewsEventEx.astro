---
// "Recent Posts / Authors' Corner / Exhibits" trio, ported from NewsEventEx.js
import { getCollection } from 'astro:content';
import { faCircleArrowRight } from '@fortawesome/free-solid-svg-icons';
import Icon from './Icon.astro';

const [news, exhibits] = await Promise.all([getCollection('news'), getCollection('exhibits')]);

const latest = (type: string) =>
  news
    .filter((p) => p.data.type === type)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];

const newsPost = latest('news');
const acPost = latest('author-corner');
const latestExhibits = exhibits
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 4);

const preview = (entry: typeof newsPost, words: number) => {
  const html = entry?.rendered?.html ?? entry?.body ?? '';
  return html.split(' ').slice(0, words).join(' ') + '...';
};
const dateStr = (d: Date) => d.toISOString().slice(0, 10);
---

<section class="flex md:flex-row flex-col gap-2 m-2">
  <article class="flex flex-col border-b-2 md:border-b-0 pb-2 md:basis-1/3">
    {newsPost && (
      <>
        <a class="flex flex-row sm:flex-wrap p-2" href="/publicity/">
          <h5 class="border-r-2 pr-2 font-serif uppercase tracking-wider text-sm self-center">
            Recent Posts
          </h5>
          <span class="pl-2 font-serif text-sm self-center text-ceci-gray-mid">
            {dateStr(newsPost.data.date)}
          </span>
        </a>
        <a class="p-2" href={`/news/${newsPost.id}/`}>
          <h5 class="font-display tracking-wide uppercase py-2 font-thin">{newsPost.data.title}</h5>
          <div
            class="font-serif text-left text-base leading-relaxed text-ceci-gray-dark dropCap"
            set:html={preview(newsPost, 30)}
          />
          <div class="font-display uppercase text-sm tracking-widest py-2">
            <Icon icon={faCircleArrowRight} class="inline mx-4" />
            Continue Reading
          </div>
        </a>
      </>
    )}
  </article>

  <article class="flex flex-col border-b-2 md:border-b-0 pb-2 md:basis-1/3">
    {acPost && (
      <>
        <a class="flex flex-row sm:flex-wrap p-2" href="/authors-corner/">
          <h5 class="border-r-2 pr-2 font-serif uppercase tracking-wider text-sm self-center">
            Authors' Corner
          </h5>
          <span class="pl-2 font-serif text-sm self-center text-ceci-gray-mid">
            {dateStr(acPost.data.date)}
          </span>
        </a>
        <a class="p-2" href={`/author-corner/${acPost.id}/`}>
          <h5 class="font-display tracking-wide uppercase py-2 font-thin">{acPost.data.title}</h5>
          <div
            class="font-serif text-left text-base p-0 leading-relaxed text-ceci-gray-dark dropCap"
            set:html={preview(acPost, 25)}
          />
          <div class="font-display uppercase text-sm tracking-widest py-2">
            <Icon icon={faCircleArrowRight} class="inline mx-4" />
            Continue Reading
          </div>
        </a>
      </>
    )}
  </article>

  <article class="flex flex-col border-b-2 md:border-b-0 pb-2 md:shrink-0 md:basis-1/3">
    <h5 class="font-serif uppercase tracking-wider text-sm">
      <a href="/exhibits/" class="p-2">exhibits</a>
    </h5>
    {latestExhibits.map((ex) => (
      <a
        class="font-display tracking-wide uppercase p-2 text-sm"
        href={`/exhibits/${ex.data.exhibit_slug}/`}
      >
        {ex.data.title}
      </a>
    ))}
    <a href="/exhibits/" class="font-display uppercase text-sm tracking-widest px-2 py-4">
      <Icon icon={faCircleArrowRight} class="inline mr-4" />
      see more exhibits
    </a>
  </article>
</section>
